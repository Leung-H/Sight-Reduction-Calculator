import skyfield
import numpy as np
import astropy
import math
from math import floor, ceil
from skyfield import api
from skyfield.api import load
from skyfield.api import Star, Angle
from astropy import units as u
import matplotlib
matplotlib.use('TkAgg',force=True)
from matplotlib import pyplot as plt

print('Hello! Welcome to the Sun Sight Reduction Program made by Harry Leung at the CCGC. Please follow the instructions below to get started.')
print('Version 1.0.1' + "\n")

sight_year = int(input('Enter the Sight Year: '))
sight_month = int(input('Enter the Sight Month: (1-12) '))
sight_day_one = int(input('Enter the Sight Day for your FIRST body (0-30): '))

print('')
print('Enter time in GMT.')
print('')

sight_hour_one = int(input('Enter the Sight Hour for your FIRST body: '))
sight_minute_one = int(input('Enter the Sight Minute for your FIRST body: '))
sight_second_one = int(input('Enter the Sight Second for your FIRST body: '))

print('Enter your DR position below')
print('North Latitudes = + Values, South Latitudes = - Values')
lat_deg = float(input('Enter your DR Latitude Degree (0°-90°): '))
lat_min = float(input('Enter your DR Latitude Minutes (0-60): '))
lat = lat_deg + (lat_min / 60)

print('West Longitude = + Values, East Longitude = - Values')
long_deg = float(input('Enter your DR Longitude Degree (0°-90°): '))
long_min = float(input('Enter your DR Longitude Minute (0-60): '))
long = long_deg + (long_min / 60)

ts = load.timescale()
t = ts.utc(sight_year, sight_month, sight_day_one, sight_hour_one, sight_minute_one, sight_second_one)
        # Load the JPL ephemeris DE421
eph = load('de421.bsp')
earth, sun, moon = eph['Earth'], eph['Sun'], eph['Moon']
sight_datetime = f'{sight_year}/{sight_month}/{sight_day_one} {sight_hour_one}:{sight_minute_one}:{sight_second_one}'
        # Apparent geocentric position of Sun at time t
barycentric = earth.at(t)
astrometric = barycentric.observe(sun)
apparent = astrometric.apparent()
        # RA and Dec using Apparent Coordinates
ra, dec, distance = apparent.radec(epoch='date')

print(f'Sight:' + "Sun")
print(f'Sight Datetime: {sight_datetime}')
print('')
        #creating 360 deg as p360 for subtracting RA
p360 = Angle(degrees=360)
p360= p360.to('degree')
ra_degrees = ra.to('degree')
SHA = p360 - ra_degrees
        #obtain GHA of Aries
gast = t.gast
gast = Angle(hours=gast)
gast = gast.to('degree')

GHA = SHA + gast
GHA = GHA % p360
print(f'GHA = {GHA}')

long = Angle(degrees=long)
long = long.to('degree')

LHA = GHA - long
LHA = LHA % p360
print(f'LHA = {LHA}')

dec_deg = dec.degrees
if dec_deg > 0.0:
  dec_degrees = floor(dec_deg)
  dec_min = (dec_deg - floor(dec_deg)) * 60.0
else:
  dec_degrees = ceil(dec_deg)
  dec_min = (dec_deg - ceil(dec_deg)) * 60.0
print(f'Dec = {dec_degrees}° {round(abs(dec_min),1)}m')

        # SKYFIELD BREAK BREAK BREAK

dec = dec.to('degree')
scalar_LHA = float(LHA.to_value(u.deg))
scalar_dec = float(dec.to_value(u.deg))

if scalar_LHA > 180:
    t_ = 360-scalar_LHA
    t_Sign = "East"
else:
    t_ = scalar_LHA
    t_Sign = "West"
if scalar_LHA > 270 or scalar_LHA < 90:
    if lat > 0:
        A_Sign="South"
    else:
        A_Sign="North"
else:
    if lat > 0:
        A_Sign="North"
    else:
        A_Sign="South"
if scalar_dec > 0:
    B_Sign = "North"
else:
    B_Sign = "South"
if A_Sign == B_Sign:
    C_Op =  "Addition"
else:
    C_Op = "Subtraction"

a = math.tan(math.radians(lat)) / math.tan(math.radians(t_))

b = math.tan(math.radians(scalar_dec)) / math.sin(math.radians(t_))

if C_Op == "Subtraction" and abs(a)>abs(b):
    c = abs(a) - abs(b)
    C_Sign = A_Sign
elif C_Op == "Subtraction" and abs(a) < abs(b):
    c = abs(b) - abs(a)
    C_Sign = B_Sign
elif C_Op == "Addition":
    c = abs(a) + abs(b)
    C_Sign = A_Sign

Q_Azimuth = math.degrees(math.atan(1/(c*math.cos(math.radians(lat)))))

if C_Sign == "North" and t_Sign == "East":
    Azimuth = Q_Azimuth
elif C_Sign == "South" and t_Sign == "East":
    Azimuth = 180 - Q_Azimuth
elif C_Sign == "South" and t_Sign == "West":
    Azimuth = 180 + Q_Azimuth
elif C_Sign == "North" and t_Sign == "West":
    Azimuth = 360 - Q_Azimuth

print("")
print("A = " + str(abs(a)) + str(" ") + A_Sign)
print("B = " + str(abs(b)) +  str(" ") + B_Sign)
print("C = " + str(abs(c))+  str(" ") + C_Sign)
print("Azimuth = " + str(C_Sign) + " " + str(round(Q_Azimuth,2)) + " " +str(t_Sign) )
print("")
print("The True Azimuth is " + str(round(Azimuth,2)) + "°T")

# NEW CODE

if lat > 0 and dec > 0 or lat < 0 and dec < 0:
    CZX_one = math.degrees(math.acos(math.cos(math.radians(math.fabs(lat)))*math.cos(math.radians(math.fabs(dec_deg)))*math.cos(math.radians(math.fabs(t_))) + (math.sin(math.radians(math.fabs(lat)))*math.sin(math.radians(math.fabs(dec_deg))))))
else:
   CZX_one = math.degrees(math.acos(math.cos(math.radians(math.fabs(lat)))*math.cos(math.radians(math.fabs(dec_deg)))*math.cos(math.radians(math.fabs(t_))) - math.sin(math.radians(math.fabs(lat)))*math.sin(math.radians(math.fabs(dec_deg)))))

sextant_altitude_deg = float(input('Input your Sextant Altitude degree'))
sextant_altitude_min = float(input('Input your Sextant Altitude minute'))
index_error = float(input('Input your Index Error in minutes'))
HoE = float(input('Input your height of eye in meters.'))
ul_or_ll = input('Input (UL or LL) depending if your sight is on the Upper Limb or Lower Limb.')

sextant_altitude = sextant_altitude_deg + (sextant_altitude_min / 60)
observed_altitude = sextant_altitude + (index_error/60)
dip_error = math.sqrt(HoE) * 1.76
apparent_altitude = observed_altitude - (dip_error/60)
refraction = (1/(math.tan(math.radians(apparent_altitude + (7.31/(apparent_altitude + 4.4)))))/60)

if sight_month == 1 or sight_month == 12:
    semi_diameter = 16.3/60
elif sight_month == 2 or sight_month == 11:
    semi_diameter = 16.2/60
elif sight_month == 3 or sight_month == 10:
    semi_diameter = 16.1/60
elif sight_month == 4:
    semi_diameter = 16.0/60
elif sight_month >= 5 and sight_month <= 8:
    semi_diameter = 15.8/60
elif sight_month == 9:
    semi_diameter = 15.9/60

if apparent_altitude <= 15:
    parallax = 0.2/60
elif apparent_altitude > 15 and apparent_altitude <= 75:
    parallax = 0.1/60
else:
    parallax = 0
if ul_or_ll == "UL":
    true_altitude = apparent_altitude - refraction + parallax - semi_diameter
else:
    true_altitude = apparent_altitude - refraction + parallax + semi_diameter

TZX = 90-true_altitude

if TZX > CZX_one:
    intercept = 60*(TZX - CZX_one)
    intercept_sign = "away"
else:
    intercept = 60*(CZX_one - TZX)
    intercept_sign = "towards"

print("True Altitude = " + str(round(true_altitude,2)) + "°")
print("TZX = " + str(round(TZX,2)) + "°")
print("CZX = " + str(round(CZX_one,2)) + "°")
    # First sight completed

Initial_lat = (lat_deg*60) + lat_min
Initial_long = (long_deg*60) + long_min
Initial_course = float(input("Enter True Initial Course in degrees"))
Distance = float(input("Enter Total Distance travelled"))

D_Lat = Distance * math.cos(math.radians(Initial_course))
M_Lat = Initial_lat + D_Lat / 2
Departure = Distance * math.sin(math.radians(Initial_course))
D_Long = Departure / math.cos(M_Lat * math.pi / 10800)
if Initial_course>=0 and Initial_course<=90:
    Final_lat = Initial_lat + abs(D_Lat)
    Final_long = Initial_long - abs(D_Long)
if Initial_course>90 and Initial_course<=180:
    Final_lat = Initial_lat - abs(D_Lat)
    Final_long = Initial_long - D_Long
if Initial_course>180 and Initial_course<=270:
    Final_lat = Initial_lat - abs(D_Lat)
    Final_long = Initial_long + abs(D_Long)
if Initial_course > 270 and Initial_course <= 360:
    Final_lat = Initial_lat + abs(D_Lat)
    Final_long = Initial_long + abs(D_Long)
if Final_lat > 0:
    Lat_sign = "N"
else:
    Lat_sign = "S"

if Final_long > 0:
    Long_sign = "W"
    CLong_sign = "E"
else:
    Long_sign = "E"
    CLong_sign = "W"
if abs(Final_long) > 10800:
    Final_long =  abs(Final_long) - 21600
    Long_sign , CLong_sign = CLong_sign , Long_sign

Final_long = Final_long/60
Final_lat = Final_lat/60
sight_day_two = int(input('Enter the Sight Day for your SECOND body (0-30): '))

print('')
print('Enter time in GMT.')
print('')

sight_hour_two = int(input('Enter the Sight Hour for your SECOND body: '))
sight_minute_two = int(input('Enter the Sight Minute for your SECOND body: '))
sight_second_two = int(input('Enter the Sight Second for your SECOND body: '))

ts = load.timescale()
t = ts.utc(sight_year, sight_month, sight_day_two, sight_hour_two, sight_minute_two, sight_second_two)
        # Load the JPL ephemeris DE421
eph = load('de421.bsp')
earth, sun, moon = eph['Earth'], eph['Sun'], eph['Moon']
sight_datetime = f'{sight_year}/{sight_month}/{sight_day_two} {sight_hour_two}:{sight_minute_two}:{sight_second_two}'
        # Apparent geocentric position of Sun at time t
barycentric = earth.at(t)
astrometric = barycentric.observe(sun)
apparent = astrometric.apparent()

        # RA and Dec using Apparent Coordinates

ra, dec, distance = apparent.radec(epoch='date')
print(f'Sight:' + "Sun")
print(f'Sight Datetime: {sight_datetime}')
print('')
p360_2 = Angle(degrees=360)
p360_2= p360_2.to('degree')
ra_degrees_2 = ra.to('degree')
SHA_2 = p360_2 - ra_degrees_2
        #obtain GHA of Aries
gast_2 = t.gast
gast_2 = Angle(hours=gast_2)
gast_2 = gast_2.to('degree')
GHA_2 = SHA_2 + gast_2
GHA_2 = GHA_2 % p360
print(f'GHA_2 = {GHA_2}')

Final_long = Angle(degrees=Final_long)
Final_long = Final_long.to('degree')
LHA_2 = GHA_2 - Final_long
LHA_2 = LHA_2 % p360_2
print(f'LHA_2 = {LHA_2}')
dec_deg_2 = dec.degrees

if dec_deg_2 > 0.0:
  dec_degrees_2 = floor(dec_deg_2)
  dec_min_2 = (dec_deg_2 - floor(dec_deg_2)) * 60.0
else:
  dec_degrees_2 = ceil(dec_deg_2)
  dec_min_2 = (dec_deg_2 - ceil(dec_deg_2)) * 60.0
print(f'Dec = {dec_degrees_2}° {round(abs(dec_min_2),1)}m')
dec_2 = dec.to('degree')
scalar_LHA_2 = float(LHA_2.to_value(u.deg))
scalar_dec_2 = float(dec_2.to_value(u.deg))

if scalar_LHA_2 > 180:
    t__2 = 360-scalar_LHA_2
    t_Sign_2 = "East"
else:
    t__2 = scalar_LHA_2
    t_Sign_2 = "West"
if scalar_LHA_2 > 270 or scalar_LHA_2 < 90:
    if Final_lat > 0:
        A_Sign_2="South"
    else:
        A_Sign_2="North"
else:
    if Final_lat > 0:
        A_Sign_2="North"
    else:
        A_Sign_2="South"
if scalar_dec_2 > 0:
    B_Sign_2 = "North"
else:
    B_Sign_2 = "South"
if A_Sign_2 == B_Sign_2:
    C_Op_2 =  "Addition"
else:
    C_Op_2 = "Subtraction"

a_2 = math.tan(math.radians(Final_lat)) / math.tan(math.radians(t__2))

b_2 = math.tan(math.radians(scalar_dec_2)) / math.sin(math.radians(t__2))

if C_Op_2 == "Subtraction" and abs(a_2)>abs(b_2):
    c_2 = abs(a_2) - abs(b_2)
    C_Sign_2 = A_Sign_2
elif C_Op_2 == "Subtraction" and abs(a_2) < abs(b_2):
    c_2 = abs(b_2) - abs(a_2)
    C_Sign_2 = B_Sign_2
elif C_Op_2 == "Addition":
    c_2 = abs(a_2) + abs(b_2)
    C_Sign_2 = A_Sign_2

Q_Azimuth_2 = math.degrees(math.atan(1/(c_2*math.cos(math.radians(Final_lat)))))

if C_Sign_2 == "North" and t_Sign_2 == "East":
    Azimuth_2 = Q_Azimuth_2
elif C_Sign_2 == "South" and t_Sign_2 == "East":
    Azimuth_2 = 180 - Q_Azimuth_2
elif C_Sign_2 == "South" and t_Sign_2 == "West":
    Azimuth_2 = 180 + Q_Azimuth_2
elif C_Sign_2 == "North" and t_Sign_2 == "West":
    Azimuth_2 = 360 - Q_Azimuth_2

print("")
print("A = " + str(abs(a_2)) + str(" ") + A_Sign_2)
print("B = " + str(abs(b_2)) +  str(" ") + B_Sign_2)
print("C = " + str(abs(c_2))+  str(" ") + C_Sign_2)
print("Azimuth = " + str(C_Sign_2) + " " + str(round(Q_Azimuth_2,2)) + " " +str(t_Sign_2))
print("")
print("The True Azimuth is " + str(round(Azimuth_2,2)) + "°T")

# NEW CODE

if Final_lat > 0 and dec_2 > 0 or Final_lat < 0 and dec_2 < 0:
    CZX_two = math.degrees(math.acos(math.cos(math.radians(math.fabs(Final_lat)))*math.cos(math.radians(math.fabs(dec_deg_2)))*math.cos(math.radians(math.fabs(t__2))) + math.sin(math.radians(math.fabs(Final_lat)))*math.sin(math.radians(math.fabs(dec_deg_2)))))
else:
   CZX_two = math.degrees(math.acos(math.cos(math.radians(math.fabs(Final_lat)))*math.cos(math.radians(math.fabs(dec_deg_2)))*math.cos(math.radians(math.fabs(t__2))) - math.sin(math.radians(math.fabs(Final_lat)))*math.sin(math.radians(math.fabs(dec_deg_2)))))
sextant_altitude_deg_2 = float(input('Input your Sextant Altitude degree'))
sextant_altitude_min_2 = float(input('Input your Sextant Altitude minute'))
index_error_2 = float(input('Input your Index Error in minutes'))
HoE_2 = float(input('Input your height of eye in meters.'))
ul_or_ll_2 = input('Input (UL or LL) depending if your sight is on the Upper Limb or Lower Limb.')

sextant_altitude_2 = sextant_altitude_deg_2 + (sextant_altitude_min_2 / 60)
observed_altitude_2 = sextant_altitude_2 + (index_error_2/60)
dip_error_2 = math.sqrt(HoE_2) * 1.76
apparent_altitude_2 = observed_altitude_2 - (dip_error_2/60)
refraction_2 = (1/(math.tan(math.radians(apparent_altitude_2 + (7.31/(apparent_altitude_2 + 4.4)))))/60)

if sight_month == 1 or sight_month == 12:
    semi_diameter_2 = 16.3/60
elif sight_month == 2 or sight_month == 11:
    semi_diameter_2 = 16.2/60
elif sight_month == 3 or sight_month == 10:
    semi_diameter_2 = 16.1/60
elif sight_month == 4:
    semi_diameter_2 = 16.0/60
elif sight_month >= 5 and sight_month <= 8:
    semi_diameter_2 = 15.8/60
elif sight_month == 9:
    semi_diameter_2 = 15.9/60
if apparent_altitude_2 <= 15:
    parallax_2 = 0.2/60
elif apparent_altitude_2 > 15 and apparent_altitude_2 <= 75:
    parallax_2 = 0.1/60
else:
    parallax = 0

if ul_or_ll_2 == "UL":
    true_altitude_2 = apparent_altitude_2 - refraction_2 + parallax_2 - semi_diameter_2
else:
    true_altitude_2 = apparent_altitude_2 - refraction_2 + parallax_2 + semi_diameter_2

TZX_2 = 90-true_altitude_2

if TZX_2 > CZX_two:
    intercept_2 = 60*(TZX_2 - CZX_two)
    intercept_sign_2= "away"
else:
    intercept_2 = 60*(CZX_two - TZX_2)
    intercept_sign_2 = "towards"

print("True Altitude = " + str(round(true_altitude_2,2)) + "°")
print("TZX = " + str(round(TZX_2,2)) + "°")
print("CZX = " + str(round(CZX_two,2)) + "°")

 # GRAPH STARTS HERE

if intercept_sign == "away":
    Azimuth_I = 90-(Azimuth-180)
else:
    Azimuth_I = (90 - Azimuth)

if intercept_sign_2 == "away":
    Azimuth_I_2 = 90-(Azimuth_2-180)
else:
    Azimuth_I_2 = (90 - Azimuth_2)

print("First Bearing is " + str(round(Azimuth,2)) + " °T " + intercept_sign + " with an intercept of " + str(abs(round(intercept,2))) + "'")
print("Second Bearing is " + str(round(Azimuth_2,2)) + " °T " + intercept_sign_2 + " with an intercept of " + str(abs(round(intercept_2,2))) + "'")

b = intercept*math.sin(math.radians(Azimuth_I)) - (-1/(math.tan(math.radians(Azimuth_I))) * (intercept*math.cos(math.radians(Azimuth_I))))
b_2 = intercept_2*math.sin(math.radians(Azimuth_I_2)) - (-1/(math.tan(math.radians(Azimuth_I_2))) * (intercept_2*math.cos(math.radians(Azimuth_I_2))))

x = np.linspace(-10,10)

Initial_Line = math.tan(math.radians(Azimuth_I)) * x
Initial_Line_PP = (-1/(math.tan(math.radians(Azimuth_I)))* x) + b
Initial_Line_2 = math.tan(math.radians(Azimuth_I_2))* x
Initial_Line_PP_2 = (-1/(math.tan(math.radians(Azimuth_I_2)))* x) + b_2

Final_X = (b_2 - b) / (-1/(math.tan(math.radians(Azimuth_I))) - (-1/(math.tan(math.radians(Azimuth_I_2)))))
Final_Y = (-1/(math.tan(math.radians(Azimuth_I))))*Final_X + b

print("D'Lat from Plot = " + str(round(Final_Y,2)) + "'")
print("Departure from Plot = " + str(round(Final_X,2)) + "'")

Final_lat = Final_lat*60
Final_long = Final_long*60
Real_Lat = Final_lat + Final_Y
M_Lat = Final_lat + Final_Y / 2
D_Long_I = Final_X / math.cos(M_Lat * math.pi / 10800)

if Final_X > 0 and Final_Y > 0:
    Final_long = Final_long.value - abs(D_Long_I)
if Final_X > 0 and Final_Y < 0:
    Final_long = Final_long.value - D_Long_I
if Final_X < 0 and Final_Y < 0:
    Final_long = Final_long.value + abs(D_Long_I)
if Final_X < 0 and Final_Y > 0:
    Final_long = Final_long.value + abs(D_Long_I)
if Real_Lat > 0:
    Lat_sign = "N"
else:
    Lat_sign = "S"

if Final_long > 0:
    Long_sign = "W"
else:
    Long_sign = "E"

if Final_X > Final_Y:
    xmin, xmax, ymin, ymax = -np.ceil(Final_X+2), np.ceil(Final_X+2), -np.ceil(Final_X+2), np.ceil(Final_X+2)
else:
    xmin, xmax, ymin, ymax = -np.ceil(Final_Y+2), np.ceil(Final_Y+2), -np.ceil(Final_Y+2), np.ceil(Final_Y+2)

ticks_frequency = 1
fig, ax = plt.subplots(figsize=(10, 10))
fig.patch.set_facecolor('#ffffff')
ax.set(xlim=(xmin-1, xmax+1), ylim=(ymin-1, ymax+1), aspect='equal')
ax.spines['bottom'].set_position('zero')
ax.spines['left'].set_position('zero')
ax.spines['top'].set_visible(False)
ax.spines['right'].set_visible(False)
ax.set_xlabel('$x$', size=14, labelpad=-24, x=1.02)
ax.set_ylabel('$y$', size=14, labelpad=-21, y=1.02, rotation=0)
plt.text(0.49, 0.49, r"$O$", ha='right', va='top',
    transform=ax.transAxes,
         horizontalalignment='center', fontsize=14)
x_ticks = np.arange(xmin, xmax+1, ticks_frequency)
y_ticks = np.arange(ymin, ymax+1, ticks_frequency)
ax.set_xticks(x_ticks[x_ticks != 0])
ax.set_yticks(y_ticks[y_ticks != 0])
ax.set_xticks(np.arange(xmin, xmax+1), minor=True)
ax.set_yticks(np.arange(ymin, ymax+1), minor=True)
ax.grid(which='both', color='grey', linewidth=1, linestyle='-', alpha=0.2)


print("Final Lat = " + "{:.0f}".format(abs(Real_Lat) // 60) + "° " + "{:.0f}".format(
    math.floor(abs(Real_Lat) % 60)) + "' " + "{:.0f}".format(
    (abs(Real_Lat) % 60 - math.floor((abs(Real_Lat) % 60))) * 60) + '" ' + str(Lat_sign) + '\nFinal Long = ' + "{:.0f}".format(
    abs(Final_long) // 60) + "° " + "{:.0f}".format(math.floor(abs(Final_long) % 60)) + "' " + "{:.0f}".format(
    (abs(Final_long) % 60 - math.floor((abs(Final_long) % 60))) * 60) + '" ' + str(Long_sign))
plt.plot(x,Initial_Line, label ="Bearing #1", color = "green")
plt.plot(x,Initial_Line_PP, label ="Position Line #1", color = "red")
plt.plot(x,Initial_Line_2, label ="Bearing #2", color = "orange")
plt.plot(x,Initial_Line_PP_2, label ="Position Line #2", color = "blue")
plt.plot(Final_X,Final_Y, label = "Observed Position" , marker = "*", markersize=20)
plt.plot(0,0, label = "DR Position", marker = "o", markersize=8)
plt.legend()
plt.show()
